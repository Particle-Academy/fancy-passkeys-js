{
  "name": "@particle-academy/fancy-passkeys",
  "version": "0.2.0",
  "description": "Passkey (WebAuthn) login for Node — a thin, safe wrapper around @simplewebauthn/server that owns the parts it deliberately leaves to you: challenge issuance, single-use expiry, credential persistence, counter replay detection. Runtime twin of particle-academy/fancy-passkeys (PHP).",
  "keywords": [
    "passkey",
    "passkeys",
    "webauthn",
    "fido2",
    "authentication",
    "login",
    "simplewebauthn",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/fancy-passkeys-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-passkeys-js.git"
  },
  "bugs": "https://github.com/Particle-Academy/fancy-passkeys-js/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.js"
      },
      "require": {
        "types": "./dist/http.d.cts",
        "default": "./dist/http.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^13.0.0"
  },
  "devDependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
